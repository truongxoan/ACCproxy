# ACCproxy Sovereign Configuration — COPY file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên GitHub (đã có trong .gitignore).
PORT=3000
NODE_ENV=production

# --- Bí mật bắt buộc khi chạy public (tự sinh chuỗi dài ngẫu nhiên) ---
MASTER_ENCRYPTION_KEY=
JWT_SECRET=
# Mật khẩu admin TX (đặt ở đây sẽ dùng khi tạo tài khoản admin mới; bỏ trống = dùng mật khẩu admin đã đặt sẵn)
ADMIN_PASSWORD=

# --- Cửa Hàng RoboticVN (chỉ hiển thị + đặt mua, key KHÔNG lộ ra trình duyệt) ---
ROBOTICVN_API_KEY=
SHOP_MARKUP_VND=20000
# Thông tin nhận tiền khi khách đặt mua (hiện trong đơn hàng để khách chuyển khoản)
SHOP_BANK_NAME=
SHOP_BANK_ACCOUNT_NUMBER=
SHOP_BANK_ACCOUNT_NAME=
SHOP_PAYMENT_NOTE=

# --- Đăng nhập bằng Google (Google Cloud Console > OAuth client, xem HUONG-DAN-TAI-KHOAN-THUE.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ten-mien-cua-ban.com/api/auth/google/callback

AUTO_LOCK_MINUTES=5
CLIPBOARD_WIPE_SECONDS=15
